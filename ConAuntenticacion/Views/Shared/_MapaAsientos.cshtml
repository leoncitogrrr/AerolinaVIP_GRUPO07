@model List<ConAuntenticacion.Models.AsientoViewModel>
@* Mapa de cabina del Embraer Phenom 300E (proa a la izquierda). Se usa en las pantallas 7 y 8. *@
@{
    bool seleccionable = ViewData["Seleccionable"] != null && (bool)ViewData["Seleccionable"];
    Func<int, string, ConAuntenticacion.Models.AsientoViewModel> buscar =
        (fila, lado) => Model.FirstOrDefault(a => a.Fila == fila && a.Lado == lado);
    var posiciones = new[]
    {
        new { Fila = 1, Lado = "D", Css = "grid-column: 2; grid-row: 1;" },
        new { Fila = 2, Lado = "D", Css = "grid-column: 3; grid-row: 1;" },
        new { Fila = 3, Lado = "D", Css = "grid-column: 5; grid-row: 1;" },
        new { Fila = 4, Lado = "D", Css = "grid-column: 6; grid-row: 1;" },
        new { Fila = 2, Lado = "I", Css = "grid-column: 3; grid-row: 3;" },
        new { Fila = 3, Lado = "I", Css = "grid-column: 5; grid-row: 3;" },
        new { Fila = 4, Lado = "I", Css = "grid-column: 6; grid-row: 3;" }
    };
}

<style>
    .cabina { display: grid; grid-template-columns: 80px 1fr 1fr 48px 1fr 1fr 70px; grid-template-rows: auto 28px auto; gap: 8px; max-width: 760px; }
    .cabina .zona { display: flex; align-items: center; justify-content: center; font-size: .75rem; color: #6c757d; border: 1px dashed #adb5bd; border-radius: 8px; padding: 4px; text-align: center; }
    .cabina .pasillo { display: flex; align-items: center; justify-content: center; font-size: .7rem; letter-spacing: .35em; color: #6c757d; border-top: 1px dotted #ced4da; border-bottom: 1px dotted #ced4da; }
    .asiento { border: 3px solid transparent; border-radius: 12px; padding: 10px 4px; color: #fff; text-align: center; line-height: 1.15; width: 100%; min-height: 64px; }
    .asiento small { display: block; font-size: .7rem; }
    .asiento-verde { background: #198754; }
    .asiento-morado { background: #6f42c1; }
    .asiento-rojo { background: #dc3545; }
    .asiento:disabled { opacity: .92; cursor: not-allowed; }
    .asiento:not(:disabled):hover { filter: brightness(1.1); }
    .asiento.seleccionado { border-color: #000; box-shadow: inset 0 0 0 2px #fff; }
    .asiento.seleccionado strong::after { content: " ✓"; }
    .leyenda span.muestra { display: inline-block; width: 16px; height: 16px; border-radius: 4px; vertical-align: middle; margin-right: 4px; }
    @@media (max-width: 576px) {
        .cabina { grid-template-columns: 44px 1fr 1fr 24px 1fr 1fr 40px; gap: 4px; }
        .cabina .zona { font-size: .6rem; }
        .asiento { min-height: 54px; padding: 6px 2px; }
    }
</style>

<div class="card shadow-sm">
    <div class="card-body">
        <p class="small text-muted mb-2">◀ Proa (frente) · Embraer Phenom 300E · 7 asientos individuales de ventanilla</p>

        <div class="cabina" role="group" aria-label="Mapa de asientos del vuelo">
            <!-- Zonas fijas -->
            <div class="zona" style="grid-column: 1; grid-row: 1 / 3;">Cabina de mando</div>
            <div class="zona" style="grid-column: 4; grid-row: 1;">Mesa</div>
            <div class="zona" style="grid-column: 4; grid-row: 3;">Mesa</div>
            <div class="zona" style="grid-column: 7; grid-row: 1;">Baño</div>
            <div class="zona" style="grid-column: 7; grid-row: 3;">Equipaje</div>
            <div class="zona" style="grid-column: 1; grid-row: 3;">Puerta</div>
            <div class="pasillo" style="grid-column: 2 / 7; grid-row: 2;">PASILLO</div>

            <!-- Asientos: lado derecho (D) arriba, lado izquierdo (I) abajo; la fila 1 izquierda es la puerta (no existe 1I) -->
            @foreach (var p in posiciones)
            {
                var asiento = buscar(p.Fila, p.Lado);
                if (asiento != null)
                {
                    @Html.Partial("_BotonAsiento", asiento, new ViewDataDictionary { { "Seleccionable", seleccionable }, { "Posicion", p.Css } })
                }
            }
        </div>

        <!-- Leyenda siempre visible (6.2): el estado también se escribe, no solo el color -->
        <div class="leyenda small mt-3 d-flex flex-wrap gap-3">
            <div><span class="muestra asiento-verde"></span>Verde · Disponible</div>
            <div><span class="muestra asiento-morado"></span>Morado · Reservado (pendiente de pago)</div>
            <div><span class="muestra asiento-rojo"></span>Rojo · Ocupado (pagado)</div>
            @if (seleccionable)
            {
                <div><span class="muestra" style="border: 3px solid #000;"></span>Borde negro + ✓ · Su selección actual</div>
            }
        </div>
    </div>
</div>
