@model IEnumerable<ConAuntenticacion.Models.Aeronave>

@{
    ViewBag.Title = "Aeronaves";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Aeronaves</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Matricula)
        </th>
        <th>
            Estado
        </th>
        <th>
            Fabricante
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Matricula)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoAeronave.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ModeloAeronave.Fabricante)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.AeronaveId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.AeronaveId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.AeronaveId })
        </td>
    </tr>
}

</table>
