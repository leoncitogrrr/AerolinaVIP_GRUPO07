@model IEnumerable<ConAuntenticacion.Models.Itinerario>

@{
    ViewBag.Title = "Itinerarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Itinerarios</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Referencia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            Estado
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Referencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoItinerario.Descripcion)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.ItinerarioId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.ItinerarioId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.ItinerarioId })
        </td>
    </tr>
}

</table>
