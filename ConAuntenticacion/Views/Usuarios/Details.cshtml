@model ConAuntenticacion.Models.UsuarioFormViewModel
@using ConAuntenticacion.Models
@{
    ViewBag.Title = "Detalles · Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="h3">Detalles · Usuarios</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre de usuario</dt>
            <dd class="col-sm-9">@Model.UserName</dd>
            <dt class="col-sm-3">Nombres</dt>
            <dd class="col-sm-9">@Model.Nombres</dd>
            <dt class="col-sm-3">Apellidos</dt>
            <dd class="col-sm-9">@Model.Apellidos</dd>
            <dt class="col-sm-3">Correo electrónico</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Rol</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Rol</span></dd>
        </dl>
    </div>
</div>

<p class="mt-3">
    @if (ServicioUsuarios.PuedeAdministrar(User, Model.Id))
    {
        @Html.ActionLink("Editar", "Edit", new { id = Model.Id })
        @: |
    }
    @Html.ActionLink("Volver a la lista", "Index")
</p>