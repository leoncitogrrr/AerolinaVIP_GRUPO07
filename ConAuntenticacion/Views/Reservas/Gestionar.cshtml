@model ConAuntenticacion.Models.ReservaResumenViewModel
@using ConAuntenticacion.Models
@{
    ViewBag.Title = "Gestión de la reserva";
    var asientosLibres = ViewBag.AsientosLibres as Dictionary<int, List<AsientoViewModel>> ?? new Dictionary<int, List<AsientoViewModel>>();
    var cambiables = Model.Detalle.Where(d => (d.EstadoAsignacion == "PENDIENTE" || d.EstadoAsignacion == "CONFIRMADA")
                                           && !d.CheckInRealizado
                                           && d.Salida.AddHours(-PoliticasAerolinea.HorasCierreCheckIn) > DateTime.Now).ToList();
}

<h1 class="h3 mb-1">Gestión de reservas, cambios y cancelaciones</h1>
<p class="text-muted">Pantalla 14</p>
@Html.Partial("_Mensajes")
@if (!ViewData.ModelState.IsValid)
{
    @Html.ValidationSummary(false, "", new { @class = "alert alert-danger", role = "alert" })
}

@Html.Partial("_ResumenReserva", Model)

<div class="card shadow-sm mt-4">
    <div class="card-header fw-semibold">Cambio de asiento</div>
    <div class="card-body">
        <p class="small mb-2">
            Se puede cambiar el asiento de una reserva pendiente o pagada mientras el pasajero no haya hecho el check-in
            y falten más de @PoliticasAerolinea.HorasCierreCheckIn h para la salida. Solo se ofrecen asientos
            <span class="badge bg-success">disponibles</span>; el asiento anterior queda libre.
        </p>
        @if (cambiables.Count == 0)
        {
            <div class="alert alert-secondary mb-0" role="status">Ningún pasajero de esta reserva puede cambiar de asiento en este momento.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Pasajero</th>
                            <th>Vuelo</th>
                            <th>Asiento actual</th>
                            <th style="min-width: 260px;">Nuevo asiento</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in cambiables)
                        {
                            List<AsientoViewModel> libres = asientosLibres.ContainsKey(d.VueloId) ? asientosLibres[d.VueloId] : new List<AsientoViewModel>();
                            <tr>
                                <td>@d.Pasajero</td>
                                <td class="small">@d.CodigoVuelo · @d.Fecha.ToString("dd/MM/yyyy") @d.HoraSalida.ToString(@"hh\:mm")</td>
                                <td><span class="badge bg-secondary">@d.Asiento</span></td>
                                <td>
                                    @if (libres.Count == 0)
                                    {
                                        <span class="small text-muted">No hay asientos libres en este vuelo.</span>
                                    }
                                    else
                                    {
                                        using (Html.BeginForm("CambiarAsiento", "Reservas", FormMethod.Post, new { @class = "d-flex gap-1 form-cambio" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="ReservaId" value="@Model.ReservaId" />
                                            <input type="hidden" name="AsignacionId" value="@d.AsignacionId" />
                                            <select name="NuevoAsiento" class="form-select form-select-sm" required aria-label="Nuevo asiento para @d.Pasajero">
                                                <option value="">Seleccionar…</option>
                                                @foreach (var s in libres)
                                                {
                                                    <option value="@s.NumeroAsiento">@s.Codigo · @s.Ubicacion</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Cambiar</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header fw-semibold">Cancelación</div>
    <div class="card-body">
        <p class="small mb-2">
            <strong>Política propuesta (DP-08, pendiente de aprobación):</strong>
            100 % de reembolso con @PoliticasAerolinea.HorasReembolsoTotal h o más antes de la salida ·
            50 % entre @PoliticasAerolinea.HorasReembolsoParcial y @PoliticasAerolinea.HorasReembolsoTotal h ·
            con menos de @PoliticasAerolinea.HorasReembolsoParcial h no se permite cancelar ·
            una reserva pendiente (sin pago) se cancela sin costo. Al cancelar, los asientos vuelven a estar disponibles.
        </p>

        @if (!Model.PuedeCancelar)
        {
            <div class="alert alert-secondary mb-0" role="status">@Model.MotivoNoCancelar</div>
        }
        else
        {
            if (Model.EstadoCompra == "PAGADA")
            {
                <div class="alert alert-info" role="status">
                    Si cancela ahora recibirá un reembolso simulado de
                    <strong>@Model.ImporteReembolso.ToString("N2") USD (@((Model.PorcentajeReembolso * 100).ToString("0")) %)</strong>
                    y se emitirá una nota de crédito académica.
                </div>
            }
            using (Html.BeginForm("Cancelar", "Reservas", FormMethod.Post, new { id = "formCancelar" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReservaId" value="@Model.ReservaId" />
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="ConfirmaCancelacion" name="ConfirmaCancelacion" value="true" />
                    <input type="hidden" name="ConfirmaCancelacion" value="false" />
                    <label class="form-check-label" for="ConfirmaCancelacion">Confirmo que deseo cancelar la reserva @Model.CodigoReserva</label>
                </div>
                <button type="button" class="btn btn-danger" id="btnCancelar">Cancelar reserva</button>

                <!-- Modal de confirmación -->
                <div class="modal fade" id="modalCancelar" tabindex="-1" aria-labelledby="tituloCancelar" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h2 class="modal-title h5" id="tituloCancelar">¿Cancelar la reserva @Model.CodigoReserva?</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body">
                                Esta operación no se puede deshacer. Los asientos quedarán disponibles para otros clientes.
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No, volver</button>
                                <button type="submit" class="btn btn-danger">Sí, cancelar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<div class="mt-3 d-flex flex-wrap gap-2">
    @if (Model.PuedePagar)
    {
        @Html.ActionLink("Pagar ahora", "Pagar", "Compras", new { id = Model.ReservaId }, new { @class = "btn btn-primary" })
    }
    @if (User.IsInRole(RolesSistema.Counter) || User.IsInRole(RolesSistema.Administrador) || User.IsInRole(RolesSistema.SuperUsuario))
    {
        @Html.ActionLink("Volver a reservas de clientes", "Gestion", "Admin", null, new { @class = "btn btn-link" })
    }
    else
    {
        @Html.ActionLink("Volver a mis reservas", "MisReservas", null, new { @class = "btn btn-link" })
    }
</div>

@section Scripts {
    <script>
                        $(function () {
                            // Cambio de asiento: pide confirmación antes de enviar
                            $(".form-cambio").on("submit", function () {
                                var asiento = $(this).find("select option:selected").text();
                                if (!$(this).find("select").val()) {
                                    alert("Seleccione el nuevo asiento.");
                                    return false;
                                }
                                return confirm("¿Cambiar al asiento " + asiento + "?");
                            });

                            $("#btnCancelar").on("click", function () {
                                if (!$("#ConfirmaCancelacion").is(":checked")) {
                                    alert("Marque la casilla para confirmar la cancelación.");
                                    return;
                                }
                                new bootstrap.Modal(document.getElementById("modalCancelar")).show();
                            });
                        });
    </script>
}