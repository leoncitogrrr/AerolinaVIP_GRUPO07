@model IEnumerable<ConAuntenticacion.Models.Vuelo>

@{
    ViewBag.Title = "Vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Vuelos</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FechaOperacion)
        </th>
        <th>
            Aeronave
        </th>
        <th>
            Estado
        </th>
        <th>
            Frecuencia
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.FechaOperacion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeronave.Matricula)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoVuelo.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Frecuencia.FrecuenciaId)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.VueloId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.VueloId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.VueloId })
        </td>
    </tr>
}

</table>
