@model ConAuntenticacion.Models.ComprobanteViewModel
@using ConAuntenticacion.Models
@{
    ViewBag.Title = "Comprobante " + Model.Encabezado.NumeroComprobante;
    var e = Model.Encabezado;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 d-print-none">
    <h1 class="h3 mb-0">Comprobante académico</h1>
    <div>
        @Html.ActionLink("Descargar PDF", "Pdf", new { id = e.ComprobanteId }, new { @class = "btn btn-primary" })
        <button type="button" class="btn btn-outline-dark" onclick="window.print()">Imprimir</button>
        @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-link" })
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header text-white d-flex flex-wrap justify-content-between align-items-center gap-2" style="background:#0b1f3a;">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width:56px;height:56px;background:#d4af37;color:#0b1f3a;">VIP</div>
            <div>
                <div class="fs-5 fw-bold">@e.EmisorNombre</div>
                <div class="small opacity-75">Identificación: @e.EmisorIdentificacion · @e.EmisorDireccion</div>
            </div>
        </div>
        <div class="text-end">
            <div class="small" style="color:#d4af37;">@e.TipoComprobante</div>
            <div class="fs-5 fw-bold">N.º @e.NumeroComprobante</div>
            <div class="small">Estado: @e.EstadoComprobanteCodigo</div>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-2 small mb-3">
            <div class="col-6 col-md-3"><span class="text-muted d-block">Fecha de emisión</span>@e.FechaEmision.ToString("dd/MM/yyyy HH:mm")</div>
            <div class="col-6 col-md-3"><span class="text-muted d-block">Código de reserva</span>@e.CodigoReserva</div>
            <div class="col-6 col-md-3"><span class="text-muted d-block">Cliente</span>@Model.Cliente</div>
            <div class="col-6 col-md-3"><span class="text-muted d-block">Compra</span>@e.EstadoCompraCodigo</div>
            <div class="col-6 col-md-3"><span class="text-muted d-block">Pago simulado</span>@(e.MarcaTarjeta ?? "-") @e.TarjetaEnmascarada</div>
            <div class="col-6 col-md-5"><span class="text-muted d-block">Operación</span>@(e.CodigoOperacion ?? "-")</div>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead class="table-light">
                    <tr><th>Pasajero</th><th>Vuelo</th><th>Ruta</th><th>Fecha / hora</th><th>Asiento</th><th class="text-end">Valor</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Lineas)
                    {
                        <tr>
                            <td>@d.Pasajero</td>
                            <td>@d.CodigoVuelo</td>
                            <td>@d.Ruta</td>
                            <td>@d.Fecha.ToString("dd/MM/yyyy") @d.HoraSalida.ToString(@"hh\:mm")</td>
                            <td>@d.Asiento</td>
                            <td class="text-end">@d.Importe.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="row justify-content-end">
            <div class="col-12 col-md-5">
                <dl class="row mb-0">
                    <dt class="col-7 fw-normal">Subtotal (tarifas)</dt><dd class="col-5 text-end">@Model.Subtotal.ToString("N2") @e.MonedaCodigo</dd>
                    <dt class="col-7 fw-normal">IVA (@((PoliticasAerolinea.PorcentajeIva * 100).ToString("0")) %)</dt><dd class="col-5 text-end">@Model.Iva.ToString("N2") @e.MonedaCodigo</dd>
                    <dt class="col-7">VALOR TOTAL</dt><dd class="col-5 text-end fw-bold fs-5">@Model.Total.ToString("N2") @e.MonedaCodigo</dd>
                    @if (Model.ImporteReembolso > 0)
                    {
                        <dt class="col-7 text-danger">Reembolso simulado</dt><dd class="col-5 text-end text-danger fw-bold">@Model.ImporteReembolso.ToString("N2") @e.MonedaCodigo</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
    <div class="card-footer small text-muted">
        @e.LeyendaComprobante Pago simulado con fines académicos.
    </div>
</div>
