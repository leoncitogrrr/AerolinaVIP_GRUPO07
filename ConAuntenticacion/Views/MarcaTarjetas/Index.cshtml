@model IEnumerable<ConAuntenticacion.Models.MarcaTarjeta>

@{
    ViewBag.Title = "Marcas de tarjeta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Marcas de tarjeta</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Nombre)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LongitudNumero)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.LongitudCodigoSeguridad)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.PrefijosReferencia)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.RutaLogo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Activa)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Nombre)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LongitudNumero)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.LongitudCodigoSeguridad)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PrefijosReferencia)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.RutaLogo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activa)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.Codigo }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.Codigo }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.Codigo })
        </td>
    </tr>
}

</table>
