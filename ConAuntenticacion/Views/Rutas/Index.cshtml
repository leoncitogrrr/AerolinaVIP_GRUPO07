@model IEnumerable<ConAuntenticacion.Models.Ruta>

@{
    ViewBag.Title = "Rutas y tarifas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Rutas y tarifas</h2>

<p>
    @Html.ActionLink("Crear nuevo", "Create")
</p>
<table class="table table-hover align-middle">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TarifaReferencial)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Activa)
        </th>
        <th>
            Destino
        </th>
        <th>
            Origen
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TarifaReferencial)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Activa)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto.CodigoIATA)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Aeropuerto1.CodigoIATA)
        </td>
        <td>
            @Html.ActionLink("Editar", "Edit", new { id=item.RutaId }) |
            @Html.ActionLink("Detalles", "Details", new { id=item.RutaId }) |
            @Html.ActionLink("Eliminar", "Delete", new { id=item.RutaId })
        </td>
    </tr>
}

</table>
