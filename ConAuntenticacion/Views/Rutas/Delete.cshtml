@model ConAuntenticacion.Models.Ruta

@{
    ViewBag.Title = "Eliminar · Rutas y tarifas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Eliminar · Rutas y tarifas</h2>

<h3>¿Está seguro de eliminar este registro?</h3>
<div>
    <h4>Ruta</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.TarifaReferencial)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.TarifaReferencial)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Activa)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Activa)
        </dd>

        <dt>
            Destino
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Aeropuerto.CodigoIATA)
        </dd>

        <dt>
            Origen
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Aeropuerto1.CodigoIATA)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            @Html.ActionLink("Volver a la lista", "Index")
        </div>
    }
</div>
